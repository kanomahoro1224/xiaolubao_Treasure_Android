<?xml version="1.0" encoding="utf-8"?>
<!-- B站粉丝卡片声明。2x2 只出粉丝数，横向拉宽到 2x4 换成头像 + 折线图。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="180dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_fans_small"
    android:initialKeyguardLayout="@layout/widget_fans_small"
    android:previewLayout="@layout/widget_fans_small"
    android:previewImage="@drawable/widget_preview_fans"
    android:description="@string/widget_fans_desc" />
