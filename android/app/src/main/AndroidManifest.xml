<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 联网：Flutter 模板只在 debug/profile 变体里给 INTERNET（供 hot reload 用），
         release 变体必须在这里显式声明，否则打出来的包一行数据都拉不到。 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 写系统日历（add_2_calendar 插件的 manifest 是空的，权限得由宿主声明） -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <uses-permission android:name="android.permission.WRITE_CALENDAR"/>

    <!-- 设置页允许填自建实例（可能是 http://）：Android 9+ 默认禁明文，
         不开这一项那条自定义地址会静默失败。 -->
    <application
        android:label="小鹿包们的宝物"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <!-- ===== 第一套：纯安卓原生小部件 =====
             小米官方《小部件提交审核与上传操作指南》pId=1584：「"小米小部件"非安卓原生小部件，
             若仅适配安卓原生小部件则无需通过小米审核」。本地安装 / 未上架的 APK 只有走这条路，
             才能出现在「长按桌面 → 小部件 → 搜索 → 安卓小部件」列表里。
             因此这一套**不挂任何 miuiWidget 标识、不声明 miui action、不指定 :widgetProvider 进程**：
             一旦带了小米标识，系统就把它归类成"小米小部件"送去审核队列，未通过审核时
             小部件中心不展示、原生列表也不收录，等于完全看不到。 -->
        <receiver
            android:name=".widget.ScheduleWidgetProvider"
            android:exported="true"
            android:label="@string/widget_schedule_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_schedule_info" />
        </receiver>
        <receiver
            android:name=".widget.BiliFansWidgetProvider"
            android:exported="true"
            android:label="@string/widget_fans_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_fans_info" />
        </receiver>

        <!-- ===== 第二套：小米小部件（澎湃 OS）=====
             按《小部件技术规范与系统能力说明》pId=1584 配置，上架审核通过后
             在「小部件中心」展示。未上架期间这两张卡在手机上不可见是系统行为，
             与代码无关；但第一套原生卡照常可用，互不影响。
             - :widgetProvider 独立进程，内存 ≤35M、不得拉起主进程
             - miuiWidget=true 是小米 Widget 标识
             - miui.appwidget.action.APPWIDGET_UPDATE 是小米「展现刷新」入口
             - label 2~8 个汉字、不得与应用同名，也不得与第一套同名（避免被聚合） -->
        <receiver
            android:name=".widget.ScheduleMiWidgetProvider"
            android:exported="true"
            android:label="@string/widget_schedule_mi_name"
            android:process=":widgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="miuiWidget"
                android:value="true" />
            <meta-data
                android:name="miuiWidgetRefresh"
                android:value="exposure" />
            <meta-data
                android:name="miuiWidgetRefreshMinInterval"
                android:value="20000" />
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_schedule_mi_info" />
        </receiver>
        <receiver
            android:name=".widget.BiliFansMiWidgetProvider"
            android:exported="true"
            android:label="@string/widget_fans_mi_name"
            android:process=":widgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="miuiWidget"
                android:value="true" />
            <meta-data
                android:name="miuiWidgetRefresh"
                android:value="exposure" />
            <meta-data
                android:name="miuiWidgetRefreshMinInterval"
                android:value="20000" />
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_fans_mi_info" />
        </receiver>
        <!-- 小部件版本号：规范要求放在 <application> 下，整数只增。
             5：4 个布局按鸿蒙卡片 1:1 重写（标签底、今日圆圈、分割线、折线填充、
             status 三态全变了），布局变更必须递增，否则系统继续吃旧缓存。 -->
        <meta-data
            android:name="miuiWidgetVersion"
            android:value="7" />
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
